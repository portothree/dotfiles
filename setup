#!/usr/bin/env bash
# Apply this flake to the current machine.
# Usage: ./setup [--update] [host]   (host defaults to the short hostname)
set -euo pipefail
cd "$(dirname "$0")"

if [ "${1:-}" = "--update" ]; then
	nix flake update
	shift
fi
host="${1:-$(hostname -s)}"

has_output() {
	nix eval --json ".#$1" --apply builtins.attrNames 2>/dev/null | grep -q "\"$host\""
}

if has_output darwinConfigurations; then
	if command -v darwin-rebuild >/dev/null; then
		sudo darwin-rebuild switch --flake ".#$host"
	else
		sudo nix run nix-darwin/nix-darwin-26.05#darwin-rebuild -- switch --flake ".#$host"
	fi
elif has_output nixosConfigurations; then
	sudo nixos-rebuild switch --flake ".#$host"
elif has_output homeConfigurations; then
	nix run home-manager/release-26.05 -- switch --flake ".#$host"
else
	echo "No configuration for host '$host' in this flake" >&2
	exit 1
fi
