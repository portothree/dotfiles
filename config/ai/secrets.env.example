# Secrets for the templated configs (Zed settings.json).
# Real values live in Bitwarden, secure note "dotfiles secrets.env".
# Copy that note to ~/.config/dotfiles/secrets.env (chmod 600); home-manager
# reads it on every switch. Never commit the real file.
SLACK_MCP_XOXC_TOKEN=''
SLACK_MCP_XOXD_TOKEN=''
CONTEXT7_API_KEY=''
GITHUB_MCP_TOKEN=''
LUNCHMONEY_API_TOKEN=''
# Obsidian Local REST API plugin (Settings > Local REST API > API key). Its HTTPS cert is
# self-signed: trust the plugin's CA once (it's restricted to 127.0.0.1/localhost):
#   sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain <ca.pem>
OBSIDIAN_MCP_TOKEN=''
