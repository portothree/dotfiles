{
  "env": {
    "ANTHROPIC_BASE_URL": "http://p8s.tailea386.ts.net"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(//Users/gustavoporto/**)",
      "mcp__basic-memory__recent_activity",
      "mcp__basic-memory__build_context",
      "mcp__basic-memory__search_notes",
      "mcp__basic-memory__search",
      "mcp__basic-memory__read_note",
      "mcp__basic-memory__list_directory",
      "mcp__basic-memory__write_note",
      "mcp__basic-memory__edit_note"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Before your first reply, use the memory-continue skill to load Basic Memory context for the $(basename \"$PWD\") project and recent related work.\""
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/basic-memory-health.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'If this thread has settled decisions, root causes or open items not yet in Basic Memory, update its note with the memory-capture skill (one note per thread, rewritten in place, never a transcript). Skip it for small talk and quick lookups.'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/gustavoporto/.claude/abtop-statusline.sh"
  },
  "enabledPlugins": {
    "notion-workspace-plugin@notion-plugin-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "slack@claude-plugins-official": true,
    "ocos@opencoreos": true
  },
  "extraKnownMarketplaces": {
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "opencoreos": {
      "source": {
        "source": "github",
        "repo": "opencoreos/claude-plugins"
      }
    }
  },
  "outputStyle": "ADHD",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "voiceEnabled": true,
  "model": "opus"
}
