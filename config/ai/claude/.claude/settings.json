{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(//Users/gustavoporto/**)",
      "mcp__basic-memory__recent_activity",
      "mcp__basic-memory__build_context",
      "mcp__basic-memory__search_notes",
      "mcp__basic-memory__search",
      "mcp__basic-memory__read_note",
      "mcp__basic-memory__list_directory",
      "mcp__basic-memory__write_note",
      "mcp__basic-memory__edit_note"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Before your first reply, use the memory-continue skill to load Basic Memory context for the $(basename \"$PWD\") project and recent related work.\""
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/basic-memory-health.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/gustavoporto/.claude/abtop-statusline.sh"
  },
  "enabledPlugins": {
    "notion-workspace-plugin@notion-plugin-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "outputStyle": "ADHD",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "voiceEnabled": true
}
