// Zed settings
//
// Template: home-manager fills each ${VAR} from ~/.config/dotfiles/secrets.env
// (see config/ai/secrets.env.example) and writes ~/.config/zed/settings.json.
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "markdown_preview": {
    "font_family": "Fira Code",
    "code_font_family": "Fira Code"
  },
  "cli_default_open_behavior": "existing_window",
  "context_server_timeout": 60,
  "use_system_window_tabs": false,
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true
  },
  "status_bar": {
    "show_active_file": false,
    "line_endings_button": false
  },
  "cursor_shape": "bar",
  "text_rendering_mode": "platform_default",
  "ui_font_family": ".ZedSans",
  "buffer_line_height": "comfortable",
  "proxy": "",
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
    "anthropic_retention": true
  },
  "restore_on_startup": "last_session",
  "tabs": {
    "show_diagnostics": "off",
    "file_icons": false,
    "git_status": false
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 400
  },
  "git_panel": {
    "group_by": "status",
    "tree_view": true,
    "dock": "left",
    "default_width": 400
  },
  "resize_all_panels_in_dock": ["left", "right", "bottom"],
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "left",
    "hide_gitignore": false,
    "default_width": 400
  },
  "disable_ai": false,
  "context_servers": {
    "aperture": {
      "enabled": true,
      "url": "http://localhost:8787/v1/mcp"
    },
    "slack-ocos": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": ["-y", "slack-mcp-server@latest", "--transport", "stdio"],
      "env": {
        "SLACK_MCP_XOXC_TOKEN": "${SLACK_MCP_XOXC_TOKEN}",
        "SLACK_MCP_XOXD_TOKEN": "${SLACK_MCP_XOXD_TOKEN}"
      }
    },
    "lunchmoney": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": ["@akutishevsky/lunchmoney-mcp"],
      "env": {
        "LUNCHMONEY_API_TOKEN": "${LUNCHMONEY_API_TOKEN}",
        "LUNCHMONEY_DEBUG": "true"
      }
    },
    "basic-memory": {
      "enabled": true,
      "remote": false,
      "command": "env",
      "args": ["-u", "PYTHONPATH", "basic-memory", "mcp", "--project", "memex"]
    },
    "chrome-devtools": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "notion": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.notion.com/mcp"]
    },
    "jamie": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.meetjamie.ai/mcp"]
    },
    "context7": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ]
    },
    "obsidian": {
      "enabled": true,
      "url": "https://127.0.0.1:27124/mcp/",
      "headers": {
        "Authorization": "Bearer ${OBSIDIAN_MCP_TOKEN}"
      }
    },
    "github": {
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    }
  },
  "agent_servers": {
    "antigravity-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "env": {
        "CODEX_INTERNAL_ORIGINATOR_OVERRIDE": "zed"
      },
      "type": "registry"
    },
    "claude-acp": {
      "env": {
        "ANTHROPIC_CUSTOM_HEADERS": "User-Agent: zed (claude-cli)"
      },
      "favorite_config_option_values": {
        "model": ["opus", "claude-fable-5-1", "fable"]
      },
      "default_config_options": {
        "fast": true,
        "mode": "bypassPermissions",
        "model": "opus"
      },
      "type": "registry"
    }
  },
  "collaboration_panel": {
    "dock": "left",
    "default_width": 400
  },
  "format_on_save": "off",
  "formatter": {
    "external": {
      "command": "prettier",
      "arguments": ["--stdin-filepath", "{buffer_path}"]
    }
  },
  "lsp": {
    "omnisharp": {
      "binary": {
        "path": "/Users/gustavoporto/OmniSharp/OmniSharp",
        "arguments": ["-lsp"]
      }
    }
  },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
      "debounce_ms": 50
    },
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  },
  "load_direnv": "shell_hook",
  "terminal": { "flexible": false },
  "agent": {
    "flexible": false,
    "default_width": 850,
    "threads_sidebar": {
      "position": "right"
    },
    "show_turn_stats": true,
    "message_editor_min_lines": 4,
    "single_file_review": false,
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "favorite_models": [],
    "play_sound_when_agent_done": "always",
    "default_model": {
      "enable_thinking": true,
      "effort": "low",
      "provider": "zed.dev",
      "model": "claude-sonnet-4-5"
    },
    "model_parameters": [],
    "default_profile": "write"
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    }
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "buffer_font_family": "Fira Code",
  "agent_buffer_font_size": 16.0,
  "buffer_font_weight": 400.0,
  "ui_font_weight": 400.0,
  "ui_font_size": 18.0,
  "buffer_font_size": 16.0,
  "agent_ui_font_size": 21.0,
  "agent_ui_font_family": "Inter",
  "theme": {
    "mode": "system",
    "light": "Oxocarbon Dark (IBM Carbon)",
    "dark": "Oxocarbon Dark (IBM Carbon)"
  }
}
